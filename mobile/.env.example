# Everything with EXPO_PUBLIC_ is compiled into the APK: public values only, never secrets.
# 10.0.2.2 is how the Android emulator reaches your PC. On a real phone use your PC's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
