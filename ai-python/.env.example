# Python AI service (bevoya-ai). Copy to .env.local and fill in.
ENVIRONMENT=local
PORT=8081
INTERNAL_SERVICE_TOKEN=
GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_TEXT_MODEL=
GEMINI_STRONG_MODEL=
# ADR-0004: gemini-embedding-2 at 768 dimensions. Changing the model means re-embedding every row.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_CONCURRENCY=
AI_TIMEOUT_SECONDS=30
SENTRY_DSN=